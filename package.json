  },
  "scripts": {
    "check:store-assets": "node tooling/check-store-assets.js",
    "dev": "extension dev",
    "start": "extension start",
    "pretest": "npm run check:store-assets",
    "test": "node --test",
    "build": "extension build",
    "build:dev": "npm run build && node tooling/build-dev.mjs",
    "prebuild:zip": "npm run check:store-assets",
    "build:zip": "npm run build && npm run build:edge && npm run build:firefox && node tooling/package-release.mjs",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge"
