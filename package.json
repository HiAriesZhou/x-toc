{
  "private": true,
  "name": "twitter-toc-extension",
  "description": "Add a floating table of contents and save useful excerpts while reading X/Twitter long-form articles.",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Aries",
    "email": "aries0331.dev@email.com",
